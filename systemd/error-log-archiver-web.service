[Unit]
Description=Error Log Archiver web console
After=network.target

[Service]
Type=simple
User=errorlogarchiver
Group=errorlogarchiver
WorkingDirectory=/opt/error-log-archiver
EnvironmentFile=/etc/error-log-archiver/runtime.env
Environment=ERROR_ARCHIVER_CONFIG_FILE=/var/lib/error-log-archiver/settings.json
Environment=ERROR_ARCHIVER_PROFILE_STORE=/var/lib/error-log-archiver/profiles.json
ExecStart=/opt/error-log-archiver/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:443 --certfile /etc/error-log-archiver/tls/server.crt --keyfile /etc/error-log-archiver/tls/server.key 'app:app'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/error-log-archiver

[Install]
WantedBy=multi-user.target
