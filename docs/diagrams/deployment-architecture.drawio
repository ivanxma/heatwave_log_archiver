        <mxCell id="network" value="&lt;b&gt;Network access&lt;/b&gt;&lt;br&gt;&lt;br&gt;OCI NSG / security list + host firewall:&lt;br&gt;Allow inbound TCP 443 for operators.&lt;br&gt;SSH TCP 22 from admin IP only.&lt;br&gt;&lt;br&gt;VM → MySQL: configured TCP port&lt;br&gt;(default 3306), or local Unix socket.&lt;br&gt;VM → OCI APIs: outbound HTTPS 443.&lt;br&gt;&lt;br&gt;TLS certificate:&lt;br&gt;/etc/error-log-archiver/tls/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#172B4D;fontFamily=Helvetica;fontSize=15;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
