        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;CONNECTIONS&lt;/b&gt;   &lt;font color=&quot;#2563EB&quot;&gt;Blue: web operations&lt;/font&gt;   ·   &lt;font color=&quot;#059669&quot;&gt;Green: scheduled archival&lt;/font&gt;   ·   &lt;font color=&quot;#7C3AED&quot;&gt;Purple dashed: secrets / IAM&lt;/font&gt;   ·   &lt;font color=&quot;#64748B&quot;&gt;Gray: local invocation / bootstrap / logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172B4D;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;fontColor=#475569;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1100" width="1700" height="35" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Deployment notes&lt;/b&gt;  Control, source and archive roles may share a MySQL host. Another Compute can use the same control server/schema; GET_LOCK serializes executions.&lt;br&gt;The console can validate source connections using Vault. Stored credentials stay in process memory. The timer evaluates the saved business interval; it does not archive on every tick." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172B4D;fontFamily=Helvetica;fontSize=15;spacing=14;align=left;verticalAlign=middle;fontColor=#475569;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1150" width="1700" height="55" as="geometry" />
        </mxCell>
