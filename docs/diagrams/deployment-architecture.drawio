        <mxCell id="network" value="OCI NSG / security list + firewall:&lt;br&gt;Inbound TCP 443 for operators.&lt;br&gt;SSH TCP 22 from admin IP only.&lt;br&gt;&lt;br&gt;VM → MySQL: configured port&lt;br&gt;(default 3306), or Unix socket.&lt;br&gt;VM → OCI APIs: HTTPS 443.&lt;br&gt;&lt;br&gt;Console TLS certificate:&lt;br&gt;/etc/error-log-archiver/tls/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#172B4D;fontFamily=Helvetica;fontSize=15;spacing=14;align=left;verticalAlign=middle;verticalAlign=top;spacingTop=87;fillColor=#FFFFFF;strokeColor=#C6C2BD;arcSize=2;fontColor=#312D2A;fontSize=14;spacingTop=76;" vertex="1" parent="1">
